{
  "name": "@graftvision/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared GraftVision UI tokens, accessible primitives, state patterns, and application shells.",
  "sideEffects": [
    "./src/styles/index.css",
    "./src/styles/tokens.css",
    "./src/styles/reset.css",
    "./src/styles/foundations.css",
    "./src/styles/primitives.css",
    "./src/styles/states.css",
    "./src/styles/information.css",
    "./src/styles/shells.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "clean": "rimraf .turbo coverage dist tsconfig.tsbuildinfo",
    "lint": "eslint . --config ../../eslint.config.mjs --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:coverage": "vitest run --config ../../vitest.config.ts --root . --coverage",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "react": "19.2.8"
  }
}
