{
  "name": "@graftvision/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Boundary for future shared and server-only GraftVision authentication helpers.",
  "sideEffects": [
    "./src/server.ts",
    "./src/server/**/*.ts"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./browser": {
      "types": "./src/browser/index.ts",
      "import": "./src/browser/index.ts",
      "default": "./src/browser/index.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "clean": "rimraf .turbo coverage dist tsconfig.tsbuildinfo",
    "lint": "eslint . --config ../../eslint.config.mjs --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:coverage": "vitest run --config ../../vitest.config.ts --root . --coverage",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@graftvision/config": "workspace:*",
    "@graftvision/database": "workspace:*",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
