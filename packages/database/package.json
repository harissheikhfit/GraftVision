{
  "name": "@graftvision/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-only PostgreSQL and trusted tenant-context boundary for GraftVision.",
  "sideEffects": [
    "./src/index.ts"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./audit": {
      "types": "./src/audit/index.ts",
      "import": "./src/audit/index.ts",
      "default": "./src/audit/index.ts"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "import": "./src/storage/index.ts",
      "default": "./src/storage/index.ts"
    },
    "./tenant": {
      "types": "./src/tenant/index.ts",
      "import": "./src/tenant/index.ts",
      "default": "./src/tenant/index.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "clean": "rimraf .turbo coverage dist tsconfig.tsbuildinfo",
    "lint": "eslint . --config ../../eslint.config.mjs --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:onnx-poc": "vitest run --config ../../vitest.config.ts src/run-onnx-inference-poc.test.ts",
    "test:expanded-onnx-poc": "vitest run --config ../../vitest.config.ts src/run-expanded-onnx-inference-poc.test.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --root . --coverage",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@graftvision/config": "workspace:*",
    "onnxruntime-node": "1.18.0",
    "pg": "8.22.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
