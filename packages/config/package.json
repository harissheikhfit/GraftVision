{
  "name": "@graftvision/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared configuration and environment-validation foundation.",
  "sideEffects": [
    "./src/env/server.ts",
    "./src/env/database.ts",
    "./src/env/admin.ts"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./env/client": {
      "types": "./src/env/client.ts",
      "import": "./src/env/client.ts",
      "default": "./src/env/client.ts"
    },
    "./env/server": {
      "types": "./src/env/server.ts",
      "import": "./src/env/server.ts",
      "default": "./src/env/server.ts"
    },
    "./env/auth": {
      "types": "./src/env/auth.ts",
      "import": "./src/env/auth.ts",
      "default": "./src/env/auth.ts"
    },
    "./env/database": {
      "types": "./src/env/database.ts",
      "import": "./src/env/database.ts",
      "default": "./src/env/database.ts"
    },
    "./env/admin": {
      "types": "./src/env/admin.ts",
      "import": "./src/env/admin.ts",
      "default": "./src/env/admin.ts"
    },
    "./env/session": {
      "types": "./src/env/session.ts",
      "import": "./src/env/session.ts",
      "default": "./src/env/session.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "clean": "rimraf .turbo coverage dist tsconfig.tsbuildinfo",
    "lint": "eslint . --config ../../eslint.config.mjs --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:coverage": "vitest run --config ../../vitest.config.ts --root . --coverage",
    "test:watch": "vitest --config ../../vitest.config.ts --root .",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "server-only": "0.0.1",
    "zod": "4.4.3"
  }
}
