# GraftVision AUTH-001 uses the disposable local Supabase Auth and PostgreSQL services.
# Copy this file to .env.local and replace the public key before running the web app.
# Never place credentials, tokens, patient data, or production values in this template.

# Framework runtime mode: development, test, or production.
# Next.js sets NODE_ENV for standard commands, so this local value is optional.
NODE_ENV=development

# CI is a runtime-provided true/false value and is not a local template setting.

# Server-only deployment context: local, test, staging, or production.
# It defaults to local for development and test for tests. It is required when
# server validation runs with NODE_ENV=production.
APP_ENV=local

# Public local Supabase Auth endpoint and publishable/legacy anonymous key.
# Obtain the disposable key with `corepack pnpm supabase:status`; never use a
# service-role or secret key in either NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Server-only local PostgreSQL connection used by packages/database and tenant tests.
# This known local Supabase value is not a remote or production credential.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Private provider variables
# No service-role, remote-project, Storage, Realtime, email, SMS, or AI credentials
# are configured. Provider credentials belong to later approved tasks.

# Application session configuration
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_IDLE_WARNING_MINUTES=25
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=60
SESSION_CLOCK_SKEW_SECONDS=30
APPLICATION_SESSION_SIGNING_KEY=replace-with-at-least-32-characters-for-local-hmac
# Optional previous signing key for rotation (must be at least 32 characters if set)
# APPLICATION_SESSION_PREVIOUS_SIGNING_KEY=
# Disabled by default: local-only COLMAP proof of concept, never client-exposed.
ENABLE_REAL_RECONSTRUCTION=false
RECONSTRUCTION_ENGINE_EXECUTABLE=/usr/local/bin/colmap
RECONSTRUCTION_ENGINE_REQUIRED_VERSION=4.1.1
RECONSTRUCTION_ENGINE_TIMEOUT_MS=300000
RECONSTRUCTION_MAX_OUTPUT_BYTES=52428800
RECONSTRUCTION_TEMP_DIRECTORY=/tmp/graftvision-reconstruction
